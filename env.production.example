# ==========================================
# 🔐 AUTHGUARD - PRODUCTION ENVIRONMENT
# ==========================================

# Application
NODE_ENV=production
PORT=3000
APP_NAME=AuthGuard
APP_VERSION=1.0.0

# Database
POSTGRES_PASSWORD=your_super_secure_db_password_here
DATABASE_URL=postgresql://authguard:${POSTGRES_PASSWORD}@postgres:5432/authguard

# JWT Secrets (générer avec: openssl rand -base64 64)
JWT_SECRET=your_jwt_secret_key_min_32_chars_please_change_this
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_min_64_chars_please_change_this
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Redis
REDIS_PASSWORD=your_redis_password_here

# TOTP/2FA
TOTP_SECRET=your_totp_secret_key_here

# Email (si nécessaire)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@yourdomain.com

# SSL Certificate (pour Certbot)
DOMAIN_NAME=api.yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# Monitoring & Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# Security
CORS_ORIGIN=https://yourdomain.com
TRUST_PROXY=true 