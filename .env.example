PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/authguard

# JWT Configuration
JWT_SECRET=change_this_to_a_secure_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_to_another_secure_secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# 2FA / TOTP
TOTP_SECRET=change_this_to_a_secure_totp_secret

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000